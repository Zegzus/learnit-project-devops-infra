[webservers]
${public_ip} ansible_user=ubuntu private_ip=${private_ip}  ansible_ssh_private_key_file=~/.ssh/id_rsa

[jenkins_servers]
${public_ip_jenkins} ansible_user=ubuntu private_ip=${private_ip_jenkins}  ansible_ssh_private_key_file=~/.ssh/id_rsa

[jenkins_agents]
${public_ip_agent} ansible_user=ubuntu private_ip=${private_ip_agent}  ansible_ssh_private_key_file=~/.ssh/id_rsa

[monitoring]
${public_ip_monitoring} ansible_user=ubuntu private_ip=${private_ip_monitoring} ansible_ssh_private_key_file=~/.ssh/id_rsa
