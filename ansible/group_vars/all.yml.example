# This documents every variable the real (encrypted) ansible/group_vars/all.yml
# must define. Copy this file, fill in real values, then encrypt it - it must
# replace ansible/group_vars/all.yml, not sit next to it under a different name:
#
#   cp ansible/group_vars/all.yml.example ansible/group_vars/all.yml
#   nano ansible/group_vars/all.yml            # fill in real secrets
#   ansible-vault encrypt ansible/group_vars/all.yml
#
# Run the playbook with:
#   ansible-playbook -i inventory.ini playbook.yml --ask-vault-pass
#
# ansible/group_vars/all.yml is vault-encrypted, so - unlike a plaintext
# secrets file - it's fine (and expected) to commit it once encrypted.
# Never commit the decrypted plaintext version.

jenkins_admin_user: "admin"
jenkins_admin_password: "CHANGE_ME_STRONG_PASSWORD"

dockerhub_user: "your-dockerhub-username"
dockerhub_pass: "your-dockerhub-access-token"   # use a Docker Hub access token, not your account password

github_username: "your-github-username"
github_token: "your-github-personal-access-token"   # needed for the JCasC seed job if the app repo is private

mysql_root_password: "CHANGE_ME_STRONG_DB_PASSWORD"   # used by the app_server docker-compose stack; must match what the app's datasource config expects

grafana_admin_password: "CHANGE_ME_STRONG_GRAFANA_PASSWORD"

discord_webhook_url: "https://discord.com/api/webhooks/xxxxx/yyyyy"

# Path (on the Ansible control machine) to the private key matching
# aws_key_pair.deployer / var.key_name in Terraform. This same key is used
# for: SSH access to all EC2 instances, the Jenkins controller -> agent SSH
# launcher, and the aws-ec2-ssh-key credential used in the Jenkinsfile deploy
# stage.
ssh_private_key_path: "~/.ssh/id_rsa"

# The application repository Jenkins should auto-create a multibranch
# pipeline job for.
app_repo_owner: "Zegzus"
app_repo_name: "learnit-project-devops-app"

# Docker Hub repo the app image is pushed to / pulled from (must match
# DOCKERHUB_REPO in the Jenkinsfile).
dockerhub_repo: "zegzus/learnit-app"
