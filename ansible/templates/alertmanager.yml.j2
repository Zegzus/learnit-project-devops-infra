global:
  resolve_timeout: 5m

route:
  receiver: discord
  group_by: ['alertname']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 3h

receivers:
  - name: discord
    slack_configs:
      # Discord accepts Slack-formatted webhook payloads if you append
      # /slack to the normal Discord webhook URL - this avoids needing a
      # separate proxy container just to talk to Discord.
      - api_url: "{{ discord_webhook_url }}/slack"
        channel: "#alerts"
        send_resolved: true
        title: '{{ "{{ .CommonAnnotations.summary }}" }}'
        text: '{{ "{{ .CommonAnnotations.description }}" }}'
