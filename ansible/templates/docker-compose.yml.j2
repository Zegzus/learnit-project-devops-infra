version: '3.8'
services:
  db:
    image: mysql:8.0
    container_name: mysql-database
    restart: unless-stopped
    environment:
      MYSQL_ROOT_PASSWORD: "{{ mysql_root_password }}"
      MYSQL_DATABASE: users_db
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "localhost"]
      interval: 5s
      timeout: 5s
      retries: 10
    volumes:
      - db-data:/var/lib/mysql
    networks:
      - devops-network

  app:
    image: {{ dockerhub_repo | default('zegzus/learnit-app') }}:latest
    container_name: learnit-app
    restart: unless-stopped
    depends_on:
      db:
        condition: service_healthy
    ports:
      - "8080:8080"
    environment:
      SPRING_DATASOURCE_URL: "jdbc:mysql://db:3306/users_db?useSSL=false&allowPublicKeyRetrieval=true"
      SPRING_DATASOURCE_USERNAME: root
      SPRING_DATASOURCE_PASSWORD: "{{ mysql_root_password }}"
      SPRING_JPA_HIBERNATE_DDL_AUTO: update
    networks:
      - devops-network

volumes:
  db-data:

networks:
  devops-network:
    driver: bridge
