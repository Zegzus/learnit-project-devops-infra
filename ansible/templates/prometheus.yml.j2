global:
  scrape_interval: 15s

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - 'alertmanager:9093'

rule_files:
  - '/etc/prometheus/alert-rules.yml'

scrape_configs:
  - job_name: 'node_exporter'
    static_configs:
      - targets:
      {% for host in groups['all'] if 'private_ip' in hostvars[host] %}
        - '{{ hostvars[host]["private_ip"] }}:9100'
      {% endfor %}